- First Chapter: {{ site.url }}{{ book.firstChapterUrl | url }}
- Chapters:
{% for ch in bookChapters[book.id] -%}
  - [{{ ch.title | safe }}]({{ site.url }}{{ ch.url | url }})
{% endfor %}

