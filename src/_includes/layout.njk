{%- set base = "/" | url -%}
{%- set pageUrlClean = page.url or '/' -%}
{%- set isBookChapter = '/Book/' in pageUrlClean -%}
{%- set isCourseLesson = '/lessons/' in pageUrlClean -%}
{%- set matchedBook = null -%}
{%- for b in books -%}
  {%- if b.url in pageUrlClean -%}
    {%- set matchedBook = b -%}
  {%- endif -%}
{%- endfor -%}
{%- set matchedCourse = null -%}
{%- for c in courses -%}
  {%- if c.url in pageUrlClean -%}
    {%- set matchedCourse = c -%}
  {%- endif -%}
{%- endfor -%}
{%- set metaTitle = title or site.title -%}
{%- set metaDesc = description -%}
{%- if not metaDesc and matchedBook -%}
  {%- if isBookChapter -%}
    {%- set metaDesc = (title or matchedBook.persianTitle) + ' — مطالعه آنلاین و رایگان از کتاب «' + matchedBook.persianTitle + '» (' + matchedBook.title + ') اثر ' + matchedBook.author + ' با ترجمه ' + matchedBook.translator + ' در گیتاب.' -%}
  {%- else -%}
    {%- set metaDesc = matchedBook.desc -%}
  {%- endif -%}
{%- elseif not metaDesc and matchedCourse -%}
  {%- set metaDesc = matchedCourse.desc -%}
{%- elseif not metaDesc -%}
  {%- set metaDesc = site.description -%}
{%- endif -%}
{%- set canonicalUrl = site.url + (pageUrlClean | url) -%}
{%- if matchedBook and matchedBook.cover -%}
  {%- set rawOgImage = matchedBook.cover -%}
{%- elseif matchedCourse and matchedCourse.thumbnail -%}
  {%- set rawOgImage = matchedCourse.thumbnail -%}
{%- else -%}
  {%- set rawOgImage = site.defaultImage -%}
{%- endif -%}
{%- set ogImageUrl = site.url + (rawOgImage | url) -%}
{%- set ogType = 'article' if (isBookChapter or isCourseLesson) else ('book' if matchedBook else 'website') -%}

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <script>
    if (window.location.pathname.startsWith('/gitab/')) {
      window.location.replace(window.location.pathname.replace(/^\/gitab\//i, '/Gitab/') + window.location.search + window.location.hash);
    }
    (() => {
      try {
        const t = localStorage.getItem('gitab-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
        document.documentElement.dataset.colorMode = t;
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.dataset.colorMode = 'dark';
      }
    })();
  </script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDesc }}">
  {% if keywords %}
  <meta name="keywords" content="{{ keywords }}">
  {% elif tags %}
  <meta name="keywords" content="{{ tags | join(', ') }}">
  {% endif %}
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="theme-color" content="#090d16">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://maps.google.com https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';">
  <link rel="icon" type="image/png" href="{{ '/favicon.png' | url }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="alternate" hreflang="fa" href="{{ canonicalUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ canonicalUrl }}">
  <link rel="alternate" type="text/plain" title="LLMs.txt" href="{{ '/llms.txt' | url }}">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="{{ '/sitemap.xml' | url }}">

  <!-- Open Graph & Social Cards -->
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDesc }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ ogImageUrl }}">
  <meta property="og:image:alt" content="{{ metaTitle }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle }}">
  <meta name="twitter:description" content="{{ metaDesc }}">
  <meta name="twitter:image" content="{{ ogImageUrl }}">

  <!-- Structured Data (Schema.org 2027 SEO & AI Discovery) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ (site.baseUrl + '/#organization') | dump | safe }},
        "name": {{ site.name | dump | safe }},
        "alternateName": "Gitab",
        "url": {{ (site.baseUrl + '/') | dump | safe }},
        "logo": {
          "@type": "ImageObject",
          "url": {{ (site.url + (site.logo | url)) | dump | safe }}
        },
        "sameAs": [{{ site.github | dump | safe }}]
      },
      {
        "@type": "WebSite",
        "@id": {{ (site.baseUrl + '/#website') | dump | safe }},
        "url": {{ (site.baseUrl + '/') | dump | safe }},
        "name": {{ site.name | dump | safe }},
        "inLanguage": "fa-IR",
        "publisher": { "@id": {{ (site.baseUrl + '/#organization') | dump | safe }} },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": {{ (site.baseUrl + '/books/list-books/?q={search_term_string}') | dump | safe }}
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "WebPage",
        "@id": {{ (canonicalUrl + '#webpage') | dump | safe }},
        "url": {{ canonicalUrl | dump | safe }},
        "name": {{ metaTitle | dump | safe }},
        "description": {{ metaDesc | dump | safe }},
        "inLanguage": "fa-IR",
        "isPartOf": { "@id": {{ (site.baseUrl + '/#website') | dump | safe }} }
      }
      {%- if matchedBook and isBookChapter -%}
      ,{
        "@type": "TechArticle",
        "headline": {{ metaTitle | dump | safe }},
        "description": {{ metaDesc | dump | safe }},
        "url": {{ canonicalUrl | dump | safe }},
        "inLanguage": "fa-IR",
        "isAccessibleForFree": true,
        "author": { "@type": "Person", "name": {{ matchedBook.author | dump | safe }} },
        "translator": { "@type": "Person", "name": {{ matchedBook.translator | dump | safe }} },
        "isPartOf": {
          "@type": "Book",
          "name": {{ matchedBook.persianTitle | dump | safe }},
          "alternateName": {{ matchedBook.title | dump | safe }},
          "url": {{ (site.url + (matchedBook.url | url)) | dump | safe }}
        }
      }
      {%- elseif matchedBook -%}
      ,{
        "@type": "Book",
        "name": {{ matchedBook.persianTitle | dump | safe }},
        "alternateName": {{ matchedBook.title | dump | safe }},
        "description": {{ metaDesc | dump | safe }},
        "url": {{ canonicalUrl | dump | safe }},
        "image": {{ ogImageUrl | dump | safe }},
        "inLanguage": "fa-IR",
        "isAccessibleForFree": true,
        "author": { "@type": "Person", "name": {{ matchedBook.author | dump | safe }} },
        "translator": { "@type": "Person", "name": {{ matchedBook.translator | dump | safe }} },
        "publisher": { "@id": {{ (site.baseUrl + '/#organization') | dump | safe }} }
      }
      {%- elseif matchedCourse and isCourseLesson -%}
      ,{
        "@type": "LearningResource",
        "learningResourceType": "Lesson",
        "name": {{ metaTitle | dump | safe }},
        "description": {{ metaDesc | dump | safe }},
        "url": {{ canonicalUrl | dump | safe }},
        "inLanguage": "fa-IR",
        "isAccessibleForFree": true,
        "isPartOf": {
          "@type": "Course",
          "name": {{ matchedCourse.persianTitle | dump | safe }},
          "url": {{ (site.url + (matchedCourse.url | url)) | dump | safe }}
        }
      }
      {%- elseif matchedCourse -%}
      ,{
        "@type": "Course",
        "name": {{ matchedCourse.persianTitle | dump | safe }},
        "alternateName": {{ matchedCourse.title | dump | safe }},
        "description": {{ metaDesc | dump | safe }},
        "url": {{ canonicalUrl | dump | safe }},
        "image": {{ ogImageUrl | dump | safe }},
        "inLanguage": "fa-IR",
        "isAccessibleForFree": true,
        "educationalLevel": {{ matchedCourse.level | dump | safe }},
        "provider": { "@id": {{ (site.baseUrl + '/#organization') | dump | safe }} }
      }
      {%- endif -%}
    ]
  }
  </script>

  <!-- پیش‌بارگذاری فونت و استایل‌های حیاتی -->
  <link rel="preload" href="{{ '/fonts/Vazirmatn.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  {%- if not isBookChapter and not isCourseLesson %}
  <link rel="preload" href="{{ '/fonts/Lalezar.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  {%- endif %}
  <link rel="preload" href="{{ '/styles/main.css?v=2.4' | url }}" as="style">
  <link rel="preload" href="{{ '/styles/gitab-modern.css?v=2.5' | url }}" as="style">

  <!-- فونت‌های رسمی پروژه: لاله‌زار و وزیرمتن متغیر (WOFF2) -->
  <style>
  @font-face {
    font-family: 'Lalezar';
    src: url('{{ '/fonts/Lalezar.woff2' | url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Vazirmatn';
    src: url('{{ '/fonts/Vazirmatn.woff2' | url }}') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  /* اعمال صریح فونت به تمام عناصر و کنترل‌های فرم */
  html, body, button, input, optgroup, select, textarea, .filter-pill {
    font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  }
  input::placeholder, textarea::placeholder {
    font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  }
  </style>

  <!-- استایل‌ها -->
  {%- set hasCodeBlocks = ('<pre' in content) or ('hljs' in content) -%}
  <link rel="stylesheet" href="{{ '/styles/main.css?v=2.4' | url }}">
  <link rel="stylesheet" href="{{ '/styles/gitab-modern.css?v=2.5' | url }}">
  {%- if hasCodeBlocks %}
  <link rel="stylesheet" href="{{ '/styles/vendor/github-dark.min.css' | url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ '/styles/vendor/github-dark.min.css' | url }}"></noscript>
  {%- endif %}
</head>

<body>
  <!-- نوبار شناور مدرن (Island Navbar) -->
  <header class="header">
    <div class="container nav-wrap">
      <a href="{{ '/' | url }}" class="brand" aria-label="صفحه اصلی گیتاب">
        <img src="{{ '/icone/logo.svg' | url }}" alt="Gitab logo" width="30" height="30" decoding="async">
        <span class="brand-text">Gitab</span>
        
      </a>

      <!-- منوی اصلی -->
      <nav class="nav" id="mainNav">
        <a href="{{ '/' | url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>خانه</a>
        <a href="{{ '/books/list-books' | url }}" {% if '/books/' in page.url and page.url != '/books/' %}aria-current="page"{% endif %}>کتاب‌ها</a>
        <a href="{{ '/courses/' | url }}" {% if '/courses/' in page.url %}aria-current="page"{% endif %}>دوره‌ها</a>
        <a href="{{ '/translator.html' | url }}" {% if page.url == '/translator.html' %}aria-current="page"{% endif %}>مترجمین</a>
      </nav>

      <div class="nav-actions">
        <!-- کلید تغییر تم -->
        <button id="themeToggle" class="theme-toggle-btn" aria-label="تغییر تم" title="تغییر تم">
          <img src="{{ '/icone/sun.svg' | url }}" class="icon-sun" alt="روشن" width="18" height="18" decoding="async" style="display:none">
          <img src="{{ '/icone/moon.svg' | url }}" class="icon-moon" alt="تاریک" width="18" height="18" decoding="async">
        </button>

        <!-- لینک گیت‌هاب -->
        <a class="btn-github-pill" href="https://github.com/hheydarian/Gitab" target="_blank" rel="noopener noreferrer" title="مشاهده سورس گیتاب در گیت‌هاب">
          <img src="{{ '/icone/github.svg' | url }}" alt="GitHub" width="16" height="16" decoding="async">
          <span>گیت‌هاب</span>
        </a>

        <!-- دکمه همبرگری موبایل -->
        <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="باز کردن منو" aria-expanded="false">
          <svg class="mob-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="14" y2="17"></line>
          </svg>
          <svg class="mob-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- منوی کشویی مدرن موبایل -->
    <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
      <div class="mobile-drawer-inner">
        <div class="mobile-drawer-section-label">ناوبری سریع</div>
        <nav class="mobile-drawer-links" aria-label="منوی موبایل">
          <a href="{{ '/' | url }}" class="mobile-drawer-link{% if page.url == '/' %} active{% endif %}"{% if page.url == '/' %} aria-current="page"{% endif %}>
            <span class="mob-nav-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 10.5 12 3l9 7.5"></path>
                <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"></path>
              </svg>
            </span>
            <span class="mob-nav-text">صفحه نخست</span>
            <span class="mob-nav-arrow" aria-hidden="true">←</span>
          </a>
          <a href="{{ '/books/list-books' | url }}" class="mobile-drawer-link{% if '/books/' in page.url and page.url != '/books/' %} active{% endif %}"{% if '/books/' in page.url and page.url != '/books/' %} aria-current="page"{% endif %}>
            <span class="mob-nav-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
              </svg>
            </span>
            <span class="mob-nav-text">کتابخانه و فهرست کتاب‌ها</span>
            <span class="mob-nav-arrow" aria-hidden="true">←</span>
          </a>
          <a href="{{ '/courses/' | url }}" class="mobile-drawer-link{% if '/courses/' in page.url %} active{% endif %}"{% if '/courses/' in page.url %} aria-current="page"{% endif %}>
            <span class="mob-nav-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            </span>
            <span class="mob-nav-text">دوره‌های آموزشی</span>
            <span class="mob-nav-arrow" aria-hidden="true">←</span>
          </a>
          <a href="{{ '/translator.html' | url }}" class="mobile-drawer-link{% if page.url == '/translator.html' %} active{% endif %}"{% if page.url == '/translator.html' %} aria-current="page"{% endif %}>
            <span class="mob-nav-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            <span class="mob-nav-text">مترجمین و همکاران</span>
            <span class="mob-nav-arrow" aria-hidden="true">←</span>
          </a>
        </nav>

        <div class="mobile-drawer-divider"></div>

        <a href="https://github.com/hheydarian/Gitab" target="_blank" rel="noopener noreferrer" class="mobile-drawer-link mobile-drawer-gh">
          <span class="mob-nav-icon" aria-hidden="true">
            <img src="{{ '/icone/github.svg' | url }}" alt="" width="17" height="17" loading="lazy" decoding="async">
          </span>
          <span class="mob-nav-text">مخزن گیت‌هاب پروژه</span>
          <span class="mob-nav-ext" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </header>

  {% set isBookPage = page.filePathStem and ('/books/' in page.filePathStem or pageUrlClean == '/courses/') %}
  {% set isChapterPage = page.filePathStem and '/Book/' in page.filePathStem %}

  {% if isChapterPage %}
    {% set bookId = page.filePathStem.split('/')[2] %}
    {% set bookHubUrl = ('/books/' + bookId + '/') | url %}
        {% set bookTitles = {
      "book1": "سی‌شارپ ۱۲ در یک نگاه",
      "book2": "کدنویسی تمیز در سی‌شارپ",
      "book3": "کد تمیز",
      "book4": "برنامه‌نویسی تسک در سی‌شارپ",
      "book5": "خط فرمان لینوکس",
      "book6": "الگوهای شاگردی",
      "book7": "برنامه‌نویس عمل‌گرا",
      "book8": "درک طراحی دامنه‌محور",
      "book9": "مهندسی پرامپت",
      "book10": "فقط برای تفریح",
      "book11": "راز بیت",
      "book12": "لینوکس و زندگی",
      "book13": "راهنمای آزمون LPIC-1",
      "book14": "ذن و هنر نگهداری دوچرخه",
      "book15": "برنامه‌نویس پرشور",
      "book16": "روان‌شناسی پول"
    } %}
    {% set currentBookTitle = bookTitles[bookId] or "کتاب" %}

    <!-- نوار پیشرفت مطالعه بالا (Reading Progress Bar) -->
    <div class="reading-progress-track">
      <div class="reading-progress-fill" id="readingProgressBar"></div>
    </div>

    <main class="site-main chapter-reading-page">
      <div class="chapter-page-wrapper">
        <!-- ۱. نوار آدرس‌دهی تمیز، کامل و سلسله‌مراتبی -->
        <nav class="chapter-clean-breadcrumb" aria-label="مسیر راهنما" dir="rtl">
          <a href="{{ '/' | url }}">خانه</a>
          <span class="bc-sep" aria-hidden="true">/</span>
          <a href="{{ '/books/list-books/' | url }}">کتاب‌ها</a>
          <span class="bc-sep" aria-hidden="true">/</span>
          <a href="{{ bookHubUrl }}"><bdi>{{ currentBookTitle }}</bdi></a>
          <span class="bc-sep" aria-hidden="true">/</span>
          <span class="bc-current-leaf"><bdi>{{ title }}</bdi></span>
        </nav>

        <!-- ۲. کانتینر بدنه مقاله (همراه با عنوان اصلی خود فصل) -->
        <article class="chapter-prose-container markdown-body" id="chapterArticle" dir="rtl">
          {{ content | safe }}
        </article>

        <!-- ۴. تک دکمه شیک فصل بعدی (تولید استاتیک و قطعی در زمان بیلد) -->
        {% set nextChapterInfo = page.url | getNextChapterInfo(bookId, bookChapters) %}
        <nav class="chapter-single-next-nav">
          {% if nextChapterInfo and not nextChapterInfo.isLast %}
            <a href="{{ nextChapterInfo.url | url }}" class="btn-next-chapter-action" id="nextChapterBtn" data-hub="{{ bookHubUrl }}">
              <span class="next-btn-text">فصل بعدی: {{ nextChapterInfo.title }}</span>
              <span class="next-btn-arrow">←</span>
            </a>
          {% else %}
            <a href="{{ bookHubUrl }}" class="btn-next-chapter-action" id="nextChapterBtn" data-hub="{{ bookHubUrl }}">
              <span class="next-btn-text">پایان کتاب — بازگشت به فهرست سرفصل‌ها</span>
              <span class="next-btn-arrow">←</span>
            </a>
          {% endif %}
        </nav>
      </div>

      <!-- دکمه شناور پرواز به بالا (Back to Top) -->
      <button class="fab-back-to-top" id="backToTopBtn" type="button" aria-label="رفتن به بالای صفحه" title="رفتن به بالا">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>
    </main>
  {% else %}
    <main class="site-main{% if isBookPage %} book-page{% endif %}">
      {{ content | safe }}
    </main>
  {% endif %}

  <!-- فوتر مینیمال، تمیز و استاندارد جهانی (Minimal Tech Footer) -->
  <footer class="footer-minimal">
    <div class="footer-container">
      <div class="footer-top-row">
        <!-- هویت و توضیحات مختصر برند -->
        <div class="footer-brand-side">
          <a href="{{ '/' | url }}" class="footer-brand-anchor">
            <img src="{{ '/icone/logo.svg' | url }}" alt="Gitab" width="28" height="28" loading="lazy" decoding="async">
            <span class="footer-brand-title">گیتاب (Gitab)</span>
          </a>
          <p class="footer-tagline">
            پلتفرم آزاد و مستقل برای ترجمهٔ دقیق و روان کتاب‌های مرجع مهندسی نرم‌افزار.
          </p>
        </div>

        <!-- ستون‌های پیوند منظم، خلوت و بدون شلوغی -->
        <div class="footer-nav-cols">
          <div class="footer-nav-col">
