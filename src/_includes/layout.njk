  <!-- اسکریپت‌های سیستمی تم، ناوبری و سرویس‌ورکر -->
  <script>
  (() => {
    const root = document.documentElement;
    const btn = document.getElementById('themeToggle');
    const sunIcon = btn ? btn.querySelector('.icon-sun') : null;
    const moonIcon = btn ? btn.querySelector('.icon-moon') : null;
    const KEY = 'gitab-theme';

    function updateTheme(mode) {
      root.setAttribute('data-theme', mode);
      root.dataset.colorMode = mode;
      if (sunIcon && moonIcon) {
        if (mode === 'dark') {
          sunIcon.style.display = 'inline-block';
          moonIcon.style.display = 'none';
        } else {
          sunIcon.style.display = 'none';
          moonIcon.style.display = 'inline-block';
        }
      }
    }

    let saved = 'dark';
    try { saved = localStorage.getItem(KEY) || 'dark'; } catch (e) {}
    updateTheme(saved);

    if (btn) {
      btn.addEventListener('click', () => {
        let current = 'dark';
        try { current = localStorage.getItem(KEY) || 'dark'; } catch (e) {}
        const next = current === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem(KEY, next); } catch (e) {}
        updateTheme(next);
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      let mode = 'dark';
      try { mode = localStorage.getItem(KEY) || 'dark'; } catch (e) {}
      updateTheme(mode);
      const yearSpan = document.getElementById('y');
      if (yearSpan) yearSpan.textContent = new Date().getFullYear();
    });

    const mobBtn = document.getElementById('mobileMenuBtn');
    const mobDrawer = document.getElementById('mobileDrawer');
    if (mobBtn && mobDrawer) {
      const setDrawerOpen = (open) => {
        mobDrawer.classList.toggle('open', open);
        mobBtn.classList.toggle('is-open', open);
        mobBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        mobBtn.setAttribute('aria-label', open ? 'بستن منو' : 'باز کردن منو');
        mobDrawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      };

      mobBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setDrawerOpen(!mobDrawer.classList.contains('open'));
      });

      mobDrawer.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => setDrawerOpen(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobDrawer.classList.contains('open')) {
          setDrawerOpen(false);
        }
      });

      document.addEventListener('click', (e) => {
        if (!mobDrawer.contains(e.target) && !mobBtn.contains(e.target)) {
          setDrawerOpen(false);
        }
      });
    }

    if ('serviceWorker' in navigator) {
      const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      if (isLocalhost) {
        navigator.serviceWorker.getRegistrations().then(regs => {
          for (const reg of regs) reg.unregister();
        });
        if ('caches' in window) {
          caches.keys().then(names => {
            for (const name of names) caches.delete(name);
          });
        }
      } else {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('{{ "/sw.js" | url }}').catch(() => {});
        });
      }
    }
  })();
  </script>

  {%- if hasCodeBlocks %}
  <!-- دکمه کپی مینیمال برای بلوک‌های کد -->
  <script>
  document.querySelectorAll('pre code').forEach(block => {
    const pre = block.parentNode;
    if (!pre || pre.querySelector('.copy-btn')) return;

    const copySvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    const okSvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', 'کپی کد');
    btn.setAttribute('title', 'کپی کد');
    btn.setAttribute('type', 'button');
    btn.innerHTML = copySvg;
    pre.appendChild(btn);

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(block.textContent);
        btn.classList.add('copied');
        btn.innerHTML = okSvg;
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = copySvg;
        }, 1800);
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });
  });
  </script>
  {%- endif %}

  {%- if isChapterPage %}
  <!-- امکانات تعاملی تجربه مطالعه فصل‌ها -->
  <script>
  (() => {
    const article = document.getElementById('chapterArticle');
    if (!article) return;

    const progressBar = document.getElementById('readingProgressBar');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const docElem = document.documentElement;
        const totalHeight = docElem.scrollHeight - docElem.clientHeight;
        if (totalHeight > 0) {
          const progress = (window.pageYOffset / totalHeight) * 100;
          progressBar.style.width = Math.min(100, Math.max(0, progress)) + '%';
        }
      }, { passive: true });
    }

    const btt = document.getElementById('backToTopBtn');
    if (btt) {
      window.addEventListener('scroll', () => {
        if (window.pageYOffset > 250) {
          btt.classList.add('visible');
        } else {
          btt.classList.remove('visible');
        }
      }, { passive: true });

      btt.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    article.querySelectorAll('img').forEach(img => {
      if (!img.hasAttribute('loading')) img.loading = 'lazy';
      if (!img.hasAttribute('decoding')) img.decoding = 'async';
      const parent = img.parentElement;
      if (parent && parent.tagName === 'P') {
        parent.style.textAlign = 'center';
      }

      img.addEventListener('error', function() {
        const src = this.getAttribute('src');
        if (src && src.includes('assets/image/')) {
          const parts = src.split('assets/image/');
          const corrected = '{{ ("/books/" + bookId + "/assets/image/") | url }}' + parts[1];
          if (this.src !== corrected) {
            this.src = corrected;
          }
        }
      });
    });

    article.querySelectorAll('p').forEach(p => {
      const trimmed = p.innerText.trim();
      if (trimmed.startsWith('💡') || trimmed.startsWith('نکته:')) {
        p.classList.add('react-callout', 'callout-tip');
      } else if (trimmed.startsWith('⚠️') || trimmed.startsWith('هشدار:')) {
        p.classList.add('react-callout', 'callout-warning');
      } else if (trimmed.startsWith('📌') || trimmed.startsWith('مهم:')) {
        p.classList.add('react-callout', 'callout-important');
      } else if (trimmed.startsWith('🔹') || trimmed.startsWith('🔸')) {
        p.classList.add('react-callout', 'callout-note');
      }
    });
  })();
  </script>
  {%- endif %}

  <!-- پیش‌واکشی هوشمند ناوبری (Speculation Rules + Fallback) -->
  <script type="speculationrules">
  {
    "prefetch": [
      {
        "where": {
          "and": [
            { "href_matches": "{{ '/' | url }}*" },
            { "not": { "href_matches": "{{ '/downloads/*' | url }}" } },
            { "not": { "selector_matches": "[download], [target='_blank']" } }
          ]
        },
        "eagerness": "moderate"
      }
    ]
  }
  </script>
  <script>
  (() => {
    if (window.HTMLScriptElement && HTMLScriptElement.supports && HTMLScriptElement.supports('speculationrules')) return;
    const seen = new Set([window.location.href]);
    let count = 0;
    const prefetchLink = (e) => {
      if (count >= 12) return;
      const a = e.target && e.target.closest ? e.target.closest('header a, .chapter-single-next-nav a, .syllabus-chapter-item a, .btn-hero-read, .btn-card-read') : null;
      if (!a || !a.href || a.hasAttribute('download') || a.target === '_blank') return;
      if (a.origin !== window.location.origin || a.pathname.includes('/downloads/')) return;
      const clean = a.href.split('#')[0];
      if (!clean || seen.has(clean)) return;
      seen.add(clean);
      count++;
      const l = document.createElement('link');
      l.rel = 'prefetch';
      l.href = clean;
      document.head.appendChild(l);
    };
    document.addEventListener('pointerenter', prefetchLink, { capture: true, passive: true });
    document.addEventListener('touchstart', prefetchLink, { capture: true, passive: true });
  })();
  </script>
</body>
